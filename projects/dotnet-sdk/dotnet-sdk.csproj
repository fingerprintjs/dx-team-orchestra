<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>dotnet_sdk</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Fingerprint.ServerSdk" Version="8.11.0" />
    <PackageReference Include="FingerprintPro.ServerSdk" Version="7.13.1" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <!-- Direct pin: the SDKs pull in BouncyCastle.Cryptography 2.6.2 transitively, which has known vulnerabilities fixed in 2.7.0 -->
    <PackageReference Include="BouncyCastle.Cryptography" Version="2.7.0" />
  </ItemGroup>

</Project>
